# The upstream Cerbero recipe is a SystemRecipe.  Keep only the Pulse client
# library in the audited user-space closure; the server and optional backends
# are intentionally not package inputs.  PulseAudio 17's meson_options.txt
# declares daemon/tests/man/doxygen as booleans and the optional backends as
# features, so Cerbero receives 'false' for the former and 'disabled' for the
# latter.
class Recipe(recipe.Recipe):
    name = 'libpulse'
    version = '17.0'
    stype = SourceType.TARBALL
    tarball_dirname = 'pulseaudio-%(version)s'
    btype = BuildType.MESON
    url = 'https://freedesktop.org/software/pulseaudio/releases/pulseaudio-17.0.tar.xz'
    tarball_checksum = '053794d6671a3e397d849e478a80b82a63cb9d8ca296bd35b73317bb5ceb87b5'
    licenses = [License.LGPLv2_1Plus]
    meson_options = {
        'daemon': 'false',
        'tests': 'false',
        'man': 'false',
        'doxygen': 'false',
        'bluez5': 'disabled',
        'alsa': 'disabled',
        'jack': 'disabled',
        'avahi': 'disabled',
        'dbus': 'disabled',
    }
    files_libs = ['libpulse']
