# Keep only the Pulse client library in the audited user-space closure; the
# server and optional backends are intentionally not package inputs. The
# PGP-signed v17.0 resolves to a commit-addressed generated archive whose
# renderer bytes are pinned by the lock SHA. It has no .tarball-version file,
# so the release-generated version is explicit.
class Recipe(recipe.Recipe):
    name = 'libpulse'
    version = '17.0'
    stype = SourceType.TARBALL
    tarball_dirname = 'pulseaudio-1f020889c9aa44ea0f63d7222e8c2b62c3f45f68'
    tarball_name = 'pulseaudio-1f020889c9aa44ea0f63d7222e8c2b62c3f45f68.tar.gz'
    btype = BuildType.MESON
    url = 'https://codeload.github.com/pulseaudio/pulseaudio/tar.gz/1f020889c9aa44ea0f63d7222e8c2b62c3f45f68'
    tarball_checksum = '0ccee8a0c9653badc668cf11f0eaad97a1febb85afa82c24c2d1935926446e3b'
    licenses = [License.LGPLv2_1Plus]
    meson_options = {
        'daemon': 'false',
        'client': 'true',
        'tests': 'false',
        'man': 'false',
        'doxygen': 'false',
        'bluez5': 'disabled',
        'alsa': 'disabled',
        'jack': 'disabled',
        'avahi': 'disabled',
        'dbus': 'disabled',
        'glib': 'disabled',
        'systemd': 'disabled',
        'x11': 'disabled',
        'oss-output': 'disabled',
        'fftw': 'disabled',
        'asyncns': 'disabled',
        'gtk': 'disabled',
        'valgrind': 'disabled',
    }
    deps = ['libsndfile']
    files_libs_lumina = ['libpulse']
    files_lumina_private = ['%(libdir)s/pulseaudio/libpulsecommon-17.0%(srext)s']

    def prepare(self):
        self.set_env('GIT_DESCRIBE_FOR_BUILD', 'v17.0')
