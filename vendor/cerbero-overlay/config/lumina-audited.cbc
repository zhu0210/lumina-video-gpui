# Cerbero 1.28.6 local configuration. The variant CSV is supplied on the
# command line so that the lock remains the one source of truth.
#
# This file intentionally contains no policy-only Meson/configure keys. The
# gst-plugins-bad GPL setting is an applied, fuzz-free patch in patches/ and
# the FFmpeg settings are asserted against the pinned upstream recipe.
variants = ['norust', 'alsa', 'pulse', 'va']
