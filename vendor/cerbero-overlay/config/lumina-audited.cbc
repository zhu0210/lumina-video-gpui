# Cerbero 1.28.6 local configuration. The CLI supplies the lock's variants;
# the lock is the sole variant authority and this file does not override it.
#
# This file intentionally contains no policy-only Meson/configure keys. The
# gst-plugins-bad GPL setting is an applied, fuzz-free patch in patches/ and
# the FFmpeg settings are asserted against the pinned upstream recipe.
# Audited/default tarball recipes win same-name conflicts while system-only
# recipes remain available.
system_recipes_priority = -1
